@model SupplierListViewModel



@{

    ViewData["Title"] = "Поставщики";

}



<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">

    <partial name="_PageHeader" model="@(new PageHeaderViewModel {

        Title = "Поставщики",

        Subtitle = "Партнёры для закупок и оформления заявок на пополнение склада",

        Icon = "bi-truck"

    })" />

    <a class="btn btn-dark align-self-start" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Добавить поставщика</a>

</div>



@if (Model.Suppliers.Count == 0)

{

    <partial name="_EmptyState" model="@(new EmptyStateViewModel {

        Title = "Поставщиков пока нет",

        Description = "Добавьте поставщика, чтобы создавать заявки на пополнение товаров",

        Icon = "bi-truck",

        ButtonText = "Добавить поставщика",

        ButtonController = "Supplier",

        ButtonAction = "Create"

    })" />

}

else

{

    <div class="row g-4">

        @foreach (var supplier in Model.Suppliers)

        {

            <div class="col-md-6 col-xl-4">

                <div class="supplier-card h-100">

                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">

                        <h2 class="h5 mb-0">@supplier.Name</h2>

                        <span class="badge text-bg-light border">@supplier.SupplyRequestsCount заявок</span>

                    </div>

                    <div class="supplier-card-meta mb-3">

                        <div class="small text-muted mb-1"><i class="bi bi-telephone me-2"></i>@(supplier.Phone ?? "—")</div>

                        <div class="small text-muted"><i class="bi bi-envelope me-2"></i>@(supplier.Email ?? "—")</div>

                    </div>

                    <a class="btn btn-outline-dark w-100" asp-action="Details" asp-route-id="@supplier.Id"><i class="bi bi-eye me-1"></i>Подробнее</a>

                </div>

            </div>

        }

    </div>

}

