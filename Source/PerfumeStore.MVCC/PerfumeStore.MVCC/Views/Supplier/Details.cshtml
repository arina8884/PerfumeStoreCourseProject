@model SupplierDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = Model.Name,
    Subtitle = "Контактные данные и история заявок поставщику",
    Icon = "bi-truck"
})" />

<div class="store-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@(Model.Email ?? "—")</dd>
        <dt class="col-sm-3">Телефон</dt>
        <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
    </dl>
</div>

<div class="store-panel-title mb-3"><i class="bi bi-clipboard-check me-2"></i>Заявки поставщику</div>

@if (Model.SupplyRequests.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Заявок пока нет",
        Description = "Создайте заявку для пополнения товаров от этого поставщика",
        Icon = "bi-clipboard",
        ButtonText = "Создать заявку",
        ButtonController = "SupplyRequest",
        ButtonAction = "Create"
    })" />
}
else
{
    <div class="table-responsive store-panel p-0 overflow-hidden mb-4">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>№</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Создал</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.SupplyRequests)
                {
                    <tr>
                        <td><span class="fw-semibold">#@request.Id</span></td>
                        <td>@request.RequestDate.ToString("g")</td>
                        <td><partial name="_SupplyRequestStatusBadge" model="@request.Status" /></td>
                        <td>@request.CreatedByFullName</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-controller="SupplyRequest" asp-action="Details" asp-route-id="@request.Id"><i class="bi bi-eye me-1"></i>Открыть</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-dark" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Изменить</a>
    <a class="btn btn-outline-dark" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>К списку</a>
</div>
