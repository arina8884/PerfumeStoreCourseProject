@model ClientOrderDetailsViewModel

@{
    ViewData["Title"] = $"Заказ #{Model.OrderId}";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = $"Заказ №{Model.OrderId}",
    Subtitle = $"Оформлен {Model.OrderDate.ToString("g")}",
    Icon = "bi-receipt"
})" />

<div class="store-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-4">Статус</dt>
        <dd class="col-sm-8"><partial name="_OrderStatusBadge" model="@Model.Status" /></dd>
        <dt class="col-sm-4">Телефон</dt>
        <dd class="col-sm-8">@(Model.ClientPhone ?? "—")</dd>
        <dt class="col-sm-4">Адрес доставки</dt>
        <dd class="col-sm-8">@Model.DeliveryAddress</dd>
        <dt class="col-sm-4">Способ доставки</dt>
        <dd class="col-sm-8">@Model.DeliveryMethod</dd>
        <dt class="col-sm-4">Способ оплаты</dt>
        <dd class="col-sm-8">@Model.PaymentMethod</dd>
        <dt class="col-sm-4">Итоговая сумма</dt>
        <dd class="col-sm-8 fw-bold">@Model.TotalAmount.ToString("N2") BYN</dd>
    </dl>
</div>

<div class="store-panel-title mb-3"><i class="bi bi-list-ul me-2"></i>Позиции заказа</div>

<div class="table-responsive store-panel p-0 overflow-hidden mb-4">
    <table class="table store-table align-middle mb-0">
        <thead>
            <tr>
                <th>Фото</th>
                <th>Товар</th>
                <th>Объём</th>
                <th>Кол-во</th>
                <th>Цена</th>
                <th>Стоимость</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <img class="rounded border bg-light" src="@ImageUrlHelper.GetProductImageUrl(item.ImageUrl)" alt="@item.ProductName" style="width:48px;height:48px;object-fit:contain;" />
                    </td>
                    <td class="fw-semibold">@item.ProductName</td>
                    <td>@item.Volume мл</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price.ToString("N2") BYN</td>
                    <td class="fw-semibold">@item.LineTotal.ToString("N2") BYN</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-dark" asp-action="Tracking" asp-route-id="@Model.OrderId"><i class="bi bi-geo-alt me-1"></i>Отслеживание</a>
    <a class="btn btn-outline-dark" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>К списку заказов</a>
</div>
