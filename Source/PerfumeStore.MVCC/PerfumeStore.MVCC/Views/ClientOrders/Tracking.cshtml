@model OrderTrackingViewModel

@{
    ViewData["Title"] = $"Отслеживание заказа #{Model.OrderId}";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = $"Отслеживание заказа №{Model.OrderId}",
    Subtitle = "Текущий этап обработки и доставки вашего заказа",
    Icon = "bi-geo-alt"
})" />

<div class="store-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-4">Дата заказа</dt>
        <dd class="col-sm-8">@Model.OrderDate.ToString("g")</dd>
        <dt class="col-sm-4">Текущий статус</dt>
        <dd class="col-sm-8"><partial name="_OrderStatusBadge" model="@Model.Status" /></dd>
    </dl>
</div>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-dark" asp-action="Details" asp-route-id="@Model.OrderId"><i class="bi bi-receipt me-1"></i>Детали заказа</a>
    <a class="btn btn-outline-dark" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>К списку заказов</a>
</div>
