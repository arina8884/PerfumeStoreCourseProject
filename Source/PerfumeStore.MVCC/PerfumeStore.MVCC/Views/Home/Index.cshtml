@model HomeViewModel

@{
    ViewData["Title"] = "Главная";
}

<section class="bg-light border rounded-3 p-5 mb-5">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-5 fw-bold">Интернет-магазин парфюмерии</h1>
            <p class="lead mb-4">Откройте каталог ароматов, найдите любимый бренд и выберите подходящий объем.</p>
            <a class="btn btn-dark btn-lg" asp-controller="Catalog" asp-action="Index">Перейти в каталог</a>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Категории</h2>
        <a asp-controller="Catalog" asp-action="Index">Все товары</a>
    </div>

    <div class="row g-3">
        @foreach (var category in Model.Categories)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a class="btn btn-outline-dark w-100" href="/catalog/category/@category.Id">
                    @category.Name
                </a>
            </div>
        }
    </div>
</section>

<section class="mb-5">
    <h2 class="h4 mb-3">Популярные товары</h2>
    <div class="row g-4">
        @foreach (var product in Model.PopularProducts)
        {
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <img class="card-img-top bg-light" src="@(product.ImageUrl ?? "/images/products/no-image.png")" alt="@product.Name" />
                    <div class="card-body">
                        <div class="text-muted small">@product.Brand</div>
                        <h3 class="h6">@product.Name</h3>
                        <p class="mb-1">@product.Volume мл</p>
                        <p class="fw-bold">@product.Price.ToString("N2")</p>
                        <a class="btn btn-outline-dark w-100" href="/product/@product.Id">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section>
    <h2 class="h4 mb-3">Новые товары</h2>
    <div class="row g-4">
        @foreach (var product in Model.NewProducts)
        {
            <div class="col-md-6 col-lg-3">
                <div class="card h-100">
                    <img class="card-img-top bg-light" src="@(product.ImageUrl ?? "/images/products/no-image.png")" alt="@product.Name" />
                    <div class="card-body">
                        <div class="text-muted small">@product.Brand</div>
                        <h3 class="h6">@product.Name</h3>
                        <p class="mb-1">@product.CategoryName</p>
                        <p class="fw-bold">@product.Price.ToString("N2")</p>
                        <a class="btn btn-outline-dark w-100" href="/product/@product.Id">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
