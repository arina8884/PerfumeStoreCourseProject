@model ReviewListViewModel

@{
    ViewData["Title"] = "Мои отзывы";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = "Мои отзывы",
    Subtitle = "Ваши оценки и комментарии к купленным ароматам",
    Icon = "bi-chat-left-quote"
})" />

@if (Model.Reviews.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Отзывов пока нет",
        Description = "Поделитесь впечатлением о товаре из каталога или карточки товара",
        Icon = "bi-chat",
        ButtonText = "Перейти в каталог",
        ButtonController = "Catalog",
        ButtonAction = "Index"
    })" />
}
else
{
    <div class="row g-3">
        @foreach (var review in Model.Reviews)
        {
            <div class="col-md-6">
                <div class="review-card h-100">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                        <div>
                            <h2 class="h6 mb-1">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@review.ProductId">@review.ProductName</a>
                            </h2>
                            <div class="text-muted small">@review.ReviewDate.ToString("g")</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge text-bg-dark"><i class="bi bi-star-fill me-1"></i>@review.Rating / 5</span>
                            <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@review.ReviewId">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@review.ReviewId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit">Удалить</button>
                            </form>
                        </div>
                    </div>
                    <p class="mb-0">@(review.Comment ?? "Без комментария")</p>
                </div>
            </div>
        }
    </div>
}
