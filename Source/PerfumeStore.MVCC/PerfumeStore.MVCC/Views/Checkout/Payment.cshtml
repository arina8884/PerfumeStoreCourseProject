@model PaymentSelectionViewModel

@{
    ViewData["Title"] = "Выбор оплаты";
}

<h1 class="h3 mb-4">Выбор оплаты</h1>

<p class="text-muted">Адрес: @Model.DeliveryAddress</p>
<p class="text-muted">Доставка: @Model.DeliveryMethod</p>
<p class="fw-bold mb-4">Сумма заказа: @Model.TotalAmount.ToString("N2")</p>

<form asp-action="Payment" asp-controller="Checkout" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @foreach (var method in Model.PaymentMethods)
    {
        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="radio"
                   name="SelectedPaymentMethod"
                   id="payment-@method"
                   value="@method"
                   checked="@(Model.SelectedPaymentMethod == method)" />
            <label class="form-check-label" for="payment-@method">@method</label>
        </div>
    }

    <span asp-validation-for="SelectedPaymentMethod" class="text-danger d-block mb-3"></span>

    <button class="btn btn-dark" type="submit">Продолжить</button>
    <a class="btn btn-outline-dark ms-2" asp-controller="Checkout" asp-action="Delivery">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
