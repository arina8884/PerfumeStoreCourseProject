@model PaymentSelectionViewModel



@{

    ViewData["Title"] = "Выбор оплаты";

    ViewData["CheckoutStep"] = 3;

}



<partial name="_PageHeader" model="@(new PageHeaderViewModel {

    Title = "Способ оплаты",

    Subtitle = "Выберите удобный вариант оплаты заказа",

    Icon = "bi-credit-card"

})" />



<partial name="_CheckoutSteps" />



<form asp-action="Payment" asp-controller="Checkout" method="post" class="store-panel store-form">

    @Html.AntiForgeryToken()



    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>



    <div class="store-panel bg-light border-0 mb-4">

        <div class="row g-3">

            <div class="col-md-6">

                <div class="small text-muted">Адрес доставки</div>

                <div class="fw-semibold">@Model.DeliveryAddress</div>

            </div>

            <div class="col-md-6">

                <div class="small text-muted">Способ доставки</div>

                <div class="fw-semibold">@Model.DeliveryMethod</div>

            </div>

            <div class="col-12">

                <div class="small text-muted">Сумма заказа</div>

                <div class="fw-bold">@Model.TotalAmount.ToString("N2") BYN</div>

            </div>

        </div>

    </div>



    <div class="store-panel-title mb-3"><i class="bi bi-wallet2 me-2"></i>Доступные способы</div>



    @foreach (var method in Model.PaymentMethods)

    {

        <div class="form-check mb-2">

            <input class="form-check-input"

                   type="radio"

                   name="SelectedPaymentMethod"

                   id="payment-@method"

                   value="@method"

                   @(Model.SelectedPaymentMethod == method ? "checked" : null) />

            <label class="form-check-label" for="payment-@method">@method</label>

        </div>

    }



    <span asp-validation-for="SelectedPaymentMethod" class="text-danger d-block mb-3"></span>



    @{ ViewData["SubmitText"] = "Продолжить"; ViewData["CancelUrl"] = Url.Action("Delivery"); ViewData["CancelText"] = "Назад"; }

    <partial name="_FormActions" />

</form>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

