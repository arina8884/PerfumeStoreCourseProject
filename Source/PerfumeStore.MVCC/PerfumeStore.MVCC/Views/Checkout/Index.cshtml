@model CheckoutViewModel

@{
    ViewData["Title"] = "Оформление заказа";
}

<h1 class="h3 mb-4">Оформление заказа</h1>

<form asp-action="Index" asp-controller="Checkout" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-4">
        <h2 class="h5">Состав заказа</h2>
        <ul class="list-group">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@item.ProductName (@item.Quantity шт.)</span>
                    <span>@item.TotalPrice.ToString("N2")</span>
                </li>
            }
        </ul>
        <p class="fw-bold mt-3">Итого: @Model.TotalAmount.ToString("N2")</p>
    </div>

    <div class="mb-4">
        <label asp-for="DeliveryAddress" class="form-label">Адрес доставки</label>
        <textarea asp-for="DeliveryAddress" class="form-control" rows="3"></textarea>
        <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
    </div>

    <button class="btn btn-dark" type="submit">Продолжить</button>
    <a class="btn btn-outline-dark ms-2" asp-controller="Cart" asp-action="Index">Вернуться в корзину</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
