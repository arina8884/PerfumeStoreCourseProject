@model CheckoutViewModel

@{
    ViewData["Title"] = "Подтверждение заказа";
}

<h1 class="h3 mb-4">Подтверждение заказа</h1>

<div class="mb-4">
    <h2 class="h5">Состав заказа</h2>
    <ul class="list-group">
        @foreach (var item in Model.Items)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@item.ProductName (@item.Quantity шт.)</span>
                <span>@item.TotalPrice.ToString("N2")</span>
            </li>
        }
    </ul>
    <p class="fw-bold mt-3">Итого: @Model.TotalAmount.ToString("N2")</p>
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">Адрес</dt>
    <dd class="col-sm-9">@Model.DeliveryAddress</dd>

    <dt class="col-sm-3">Доставка</dt>
    <dd class="col-sm-9">@Model.DeliveryMethod</dd>

    <dt class="col-sm-3">Оплата</dt>
    <dd class="col-sm-9">@Model.PaymentMethod</dd>
</dl>

<form asp-action="Confirm" asp-controller="Checkout" method="post">
    @Html.AntiForgeryToken()
    <button class="btn btn-dark" type="submit">Подтвердить заказ</button>
    <a class="btn btn-outline-dark ms-2" asp-controller="Checkout" asp-action="Payment">Назад</a>
</form>
