@model DeliverySelectionViewModel



@{

    ViewData["Title"] = "Выбор доставки";

    ViewData["CheckoutStep"] = 2;

}



<partial name="_PageHeader" model="@(new PageHeaderViewModel {

    Title = "Способ доставки",

    Subtitle = "Выберите удобный вариант получения заказа",

    Icon = "bi-truck"

})" />



<partial name="_CheckoutSteps" />



<form asp-action="Delivery" asp-controller="Checkout" method="post" class="store-panel store-form">

    @Html.AntiForgeryToken()



    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>



    <div class="store-panel bg-light border-0 mb-4">

        <div class="small text-muted">Адрес доставки</div>

        <div class="fw-semibold">@Model.DeliveryAddress</div>

        <div class="small text-muted mt-2">Сумма заказа</div>

        <div class="fw-bold">@Model.TotalAmount.ToString("N2") BYN</div>

    </div>



    <div class="store-panel-title mb-3"><i class="bi bi-truck me-2"></i>Доступные способы</div>



    @foreach (var method in Model.DeliveryMethods)

    {

        <div class="form-check mb-2">

            <input class="form-check-input"

                   type="radio"

                   name="SelectedDeliveryMethod"

                   id="delivery-@method"

                   value="@method"

                   @(Model.SelectedDeliveryMethod == method ? "checked" : null) />

            <label class="form-check-label" for="delivery-@method">@method</label>

        </div>

    }



    <span asp-validation-for="SelectedDeliveryMethod" class="text-danger d-block mb-3"></span>



    @{ ViewData["SubmitText"] = "Продолжить"; ViewData["CancelUrl"] = Url.Action("Index"); ViewData["CancelText"] = "Назад"; }

    <partial name="_FormActions" />

</form>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

