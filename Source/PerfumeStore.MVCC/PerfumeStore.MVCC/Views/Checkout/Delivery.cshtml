@model DeliverySelectionViewModel

@{
    ViewData["Title"] = "Выбор доставки";
}

<h1 class="h3 mb-4">Выбор доставки</h1>

<p class="text-muted">Адрес: @Model.DeliveryAddress</p>
<p class="fw-bold mb-4">Сумма заказа: @Model.TotalAmount.ToString("N2")</p>

<form asp-action="Delivery" asp-controller="Checkout" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @foreach (var method in Model.DeliveryMethods)
    {
        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="radio"
                   name="SelectedDeliveryMethod"
                   id="delivery-@method"
                   value="@method"
                   checked="@(Model.SelectedDeliveryMethod == method)" />
            <label class="form-check-label" for="delivery-@method">@method</label>
        </div>
    }

    <span asp-validation-for="SelectedDeliveryMethod" class="text-danger d-block mb-3"></span>

    <button class="btn btn-dark" type="submit">Продолжить</button>
    <a class="btn btn-outline-dark ms-2" asp-controller="Checkout" asp-action="Index">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
