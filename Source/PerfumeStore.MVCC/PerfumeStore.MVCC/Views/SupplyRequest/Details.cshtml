@model SupplyRequestDetailsViewModel

@{
    ViewData["Title"] = $"Заявка №{Model.Id}";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = $"Заявка №{Model.Id}",
    Subtitle = $"Поставщик: {Model.SupplierName} · {Model.RequestDate.ToString("g")}",
    Icon = "bi-clipboard-check"
})" />

<div class="store-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-4">Статус</dt>
        <dd class="col-sm-8"><partial name="_SupplyRequestStatusBadge" model="@Model.Status" /></dd>
        <dt class="col-sm-4">Создал</dt>
        <dd class="col-sm-8">@Model.CreatedByFullName</dd>
        <dt class="col-sm-4">Комментарий</dt>
        <dd class="col-sm-8">@(Model.Comment ?? "—")</dd>
    </dl>
</div>

<div class="store-panel-title mb-3"><i class="bi bi-list-ul me-2"></i>Позиции заявки</div>

@if (Model.Items.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Позиции отсутствуют",
        Description = "В этой заявке не указаны товары для закупки",
        Icon = "bi-box"
    })" />
}
else
{
    <div class="table-responsive store-panel p-0 overflow-hidden mb-4">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Товар</th>
                    <th>Количество</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.ProductName</td>
                        <td>@item.Quantity шт.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex flex-wrap gap-2">
    @if (Model.AvailableStatuses.Contains(SupplyRequestStatuses.Approved))
    {
        <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-dark" type="submit"><i class="bi bi-check-lg me-1"></i>Одобрить</button>
        </form>
    }
    @if (Model.AvailableStatuses.Contains(SupplyRequestStatuses.Completed))
    {
        <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-dark" type="submit"><i class="bi bi-check-circle me-1"></i>Завершить</button>
        </form>
    }
    @if (Model.AvailableStatuses.Contains(SupplyRequestStatuses.Rejected))
    {
        <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger" type="submit"><i class="bi bi-x-lg me-1"></i>Отклонить</button>
        </form>
    }
    <a class="btn btn-outline-dark" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>К списку</a>
</div>
