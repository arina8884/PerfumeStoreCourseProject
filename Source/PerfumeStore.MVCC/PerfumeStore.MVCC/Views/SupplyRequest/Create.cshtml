@model SupplyRequestEditViewModel



@{

    ViewData["Title"] = "Новая заявка";

}



<partial name="_PageHeader" model="@(new PageHeaderViewModel {

    Title = "Новая заявка поставщику",

    Subtitle = "Укажите поставщика и позиции для пополнения склада",

    Icon = "bi-clipboard-plus"

})" />



<form asp-action="Create" method="post" class="store-panel store-form">

    @Html.AntiForgeryToken()



    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>



    <div class="mb-3">

        <label asp-for="SupplierId" class="form-label">Поставщик</label>

        <select asp-for="SupplierId" class="form-select" asp-items="@(new SelectList(Model.Suppliers, nameof(SupplierItemViewModel.Id), nameof(SupplierItemViewModel.Name)))">

            <option value="">Выберите поставщика</option>

        </select>

        <span asp-validation-for="SupplierId" class="text-danger"></span>

    </div>



    <div class="mb-4">

        <label asp-for="Comment" class="form-label">Комментарий</label>

        <textarea asp-for="Comment" class="form-control" rows="3" placeholder="Дополнительные пожелания к заявке"></textarea>

        <span asp-validation-for="Comment" class="text-danger"></span>

    </div>



    <div class="store-panel-title mb-3"><i class="bi bi-list-ul me-2"></i>Позиции</div>



    @for (var index = 0; index < Model.Items.Count; index++)

    {

        <div class="row g-2 mb-2">

            <div class="col-md-8">

                <select asp-for="Items[index].ProductId" class="form-select" asp-items="@(new SelectList(Model.Products, nameof(ProductSelectViewModel.Id), nameof(ProductSelectViewModel.Name), Model.Items[index].ProductId))">

                    <option value="0">Выберите товар</option>

                </select>

            </div>

            <div class="col-md-4">

                <input asp-for="Items[index].Quantity" class="form-control" placeholder="Кол-во" />

                <span asp-validation-for="Items[index].Quantity" class="text-danger"></span>

            </div>

        </div>

    }



    @{ ViewData["SubmitText"] = "Создать заявку"; ViewData["CancelUrl"] = Url.Action("Index"); }

    <partial name="_FormActions" />

</form>

