@model SupplyRequestListViewModel

@{
    ViewData["Title"] = "Заявки поставщикам";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <partial name="_PageHeader" model="@(new PageHeaderViewModel {
        Title = "Заявки поставщикам",
        Subtitle = "Закупки и пополнение склада: статусы и история заявок",
        Icon = "bi-clipboard-check"
    })" />
    <a class="btn btn-dark align-self-start" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Создать заявку</a>
</div>

@if (Model.Requests.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Заявок пока нет",
        Description = "Создайте заявку поставщику для пополнения остатков на складе",
        Icon = "bi-clipboard",
        ButtonText = "Создать заявку",
        ButtonController = "SupplyRequest",
        ButtonAction = "Create"
    })" />
}
else
{
    <div class="table-responsive store-panel p-0 overflow-hidden">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>№</th>
                    <th>Поставщик</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Создал</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td><span class="fw-semibold">#@request.Id</span></td>
                        <td>@request.SupplierName</td>
                        <td>@request.RequestDate.ToString("g")</td>
                        <td><partial name="_SupplyRequestStatusBadge" model="@request.Status" /></td>
                        <td>@request.CreatedByFullName</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@request.Id"><i class="bi bi-eye me-1"></i>Открыть</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
