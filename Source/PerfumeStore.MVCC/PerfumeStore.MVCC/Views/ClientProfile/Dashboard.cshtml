@model ClientDashboardViewModel



@{

    ViewData["Title"] = "Личный кабинет";

    ViewData["MetaDescription"] = "Личный кабинет PerfumeStore — заказы, избранное, отзывы и активность покупателя.";

}



<partial name="_PageHeader" model="@(new PageHeaderViewModel {

    Title = "Личный кабинет",

    Subtitle = $"{Model.FullName}, здесь ваши заказы и избранное",

    Icon = "bi-person-circle"

})" />



<div class="row g-3 mb-4">

    <div class="col-6 col-md-4 col-xl-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Всего заказов", Value = Model.OrdersCount.ToString(), Icon = "bi-bag" })" /></div>

    <div class="col-6 col-md-4 col-xl-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Активные", Value = Model.ActiveOrdersCount.ToString(), Icon = "bi-hourglass-split", Hint = "Заказы в обработке" })" /></div>

    <div class="col-6 col-md-4 col-xl-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Доставлено", Value = Model.DeliveredOrdersCount.ToString(), Icon = "bi-check2-circle" })" /></div>

    <div class="col-6 col-md-4 col-xl-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Избранное", Value = Model.FavoritesCount.ToString(), Icon = "bi-heart" })" /></div>

    <div class="col-6 col-md-4 col-xl-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "В корзине", Value = Model.CartItemsCount.ToString(), Icon = "bi-cart3" })" /></div>

    <div class="col-6 col-md-4 col-xl-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Отзывы", Value = Model.ReviewsCount.ToString(), Icon = "bi-chat-square-text" })" /></div>

</div>



<div class="store-panel mb-4">

    <div class="store-panel-title"><i class="bi bi-grid me-2"></i>Быстрые действия</div>

    <div class="d-flex flex-wrap gap-2 store-quick-actions">

        <a class="btn btn-dark" asp-controller="Catalog" asp-action="Index"><i class="bi bi-grid me-1"></i>Каталог</a>

        <a class="btn btn-outline-dark" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3 me-1"></i>Корзина</a>

        <a class="btn btn-outline-dark" asp-controller="Favorites" asp-action="Index"><i class="bi bi-heart me-1"></i>Избранное</a>

        <a class="btn btn-outline-dark" asp-controller="Compare" asp-action="Index"><i class="bi bi-sliders me-1"></i>Сравнение</a>

        <a class="btn btn-outline-dark" asp-controller="ClientOrders" asp-action="Index"><i class="bi bi-bag me-1"></i>Мои заказы</a>

    </div>

</div>



<div class="row g-4 mb-4">

    <div class="col-lg-4">

        <div class="store-panel h-100">

            <div class="store-panel-title"><i class="bi bi-bag-check me-2"></i>Последний заказ</div>

            @if (Model.LastOrder is null)

            {

                <partial name="_EmptyState" model="@(new EmptyStateViewModel {

                    Title = "Заказов пока нет",

                    Description = "Оформите первый заказ в каталоге",

                    Icon = "bi-bag",

                    ButtonText = "Перейти в каталог",

                    ButtonController = "Catalog",

                    ButtonAction = "Index"

                })" />

            }

            else

            {

                <dl class="row store-info-list mb-0">

                    <dt class="col-5">Номер</dt>

                    <dd class="col-7">#@Model.LastOrder.OrderId</dd>

                    <dt class="col-5">Дата</dt>

                    <dd class="col-7">@Model.LastOrder.OrderDate.ToString("g")</dd>

                    <dt class="col-5">Статус</dt>

                    <dd class="col-7"><partial name="_OrderStatusBadge" model="@Model.LastOrder.Status" /></dd>

                    <dt class="col-5">Сумма</dt>

                    <dd class="col-7">@Model.LastOrder.TotalAmount.ToString("N2") BYN</dd>

                </dl>

                <a class="btn btn-outline-dark btn-sm mt-3" asp-controller="ClientOrders" asp-action="Details" asp-route-id="@Model.LastOrder.OrderId">Подробнее</a>

            }

        </div>

    </div>

    <div class="col-lg-4">

        <div class="store-panel h-100">

            <div class="store-panel-title"><i class="bi bi-chat-left-text me-2"></i>Последние отзывы</div>

            @if (Model.RecentReviews.Count == 0)

            {

                <partial name="_EmptyState" model="@(new EmptyStateViewModel {

                    Title = "Отзывов пока нет",

                    Description = "Поделитесь впечатлением о понравившемся аромате",

                    Icon = "bi-chat",

                    ButtonText = "Выбрать товар",

                    ButtonController = "Catalog",

                    ButtonAction = "Index"

                })" />

            }

            else

            {

                @foreach (var review in Model.RecentReviews)

                {

                    <div class="review-card mb-2">

                        <div class="d-flex justify-content-between gap-2 mb-1">

                            <strong class="small">@review.ProductName</strong>

                            <span class="badge text-bg-dark">@review.Rating / 5</span>

                        </div>

                        <div class="text-muted small mb-1">@review.ReviewDate.ToString("g")</div>

                        <p class="mb-0 small">@(review.Comment ?? "Без комментария")</p>

                    </div>

                }

                <a class="btn btn-outline-dark btn-sm mt-2" asp-controller="Reviews" asp-action="Index">Все отзывы</a>

            }

        </div>

    </div>

    <div class="col-lg-4">

        <div class="store-panel h-100">

            <div class="store-panel-title"><i class="bi bi-clock-history me-2"></i>Последние действия</div>

            @if (Model.RecentActivities.Count == 0)

            {

                <partial name="_EmptyState" model="@(new EmptyStateViewModel {

                    Title = "Активности пока нет",

                    Description = "Здесь появятся ваши заказы, отзывы и другие действия",

                    Icon = "bi-clock-history",

                    ButtonText = "Перейти в каталог",

                    ButtonController = "Catalog",

                    ButtonAction = "Index"

                })" />

            }

            else

            {

                @foreach (var activity in Model.RecentActivities)

                {

                    <div class="activity-item">

                        <div class="activity-item-icon"><i class="bi @activity.Icon"></i></div>

                        <div>

                            <div class="fw-semibold small">@activity.Title</div>

                            <div class="text-muted small">@activity.Description</div>

                            <div class="text-muted small">@activity.OccurredAt.ToString("g")</div>

                        </div>

                    </div>

                }

            }

        </div>

    </div>

</div>



<div class="store-panel">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

        <div class="store-panel-title mb-0"><i class="bi bi-list-ul me-2"></i>Мои заказы</div>

        <a class="btn btn-sm btn-outline-dark" asp-controller="ClientOrders" asp-action="Index">Все заказы</a>

    </div>

    @if (Model.LastOrder is null)

    {

        <partial name="_EmptyState" model="@(new EmptyStateViewModel {

            Title = "История заказов пуста",

            Description = "После оформления покупки заказы появятся в этом разделе",

            Icon = "bi-bag",

            ButtonText = "Перейти в каталог",

            ButtonController = "Catalog",

            ButtonAction = "Index"

        })" />

    }

    else

    {

        <div class="table-responsive">

            <table class="table store-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>№</th>

                        <th>Дата</th>

                        <th>Статус</th>

                        <th>Сумма</th>

                        <th class="text-end">Действия</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td class="fw-semibold">#@Model.LastOrder.OrderId</td>

                        <td>@Model.LastOrder.OrderDate.ToString("g")</td>

                        <td><partial name="_OrderStatusBadge" model="@Model.LastOrder.Status" /></td>

                        <td>@Model.LastOrder.TotalAmount.ToString("N2") BYN</td>

                        <td class="text-end">

                            <a class="btn btn-sm btn-outline-dark" asp-controller="ClientOrders" asp-action="Details" asp-route-id="@Model.LastOrder.OrderId">Открыть</a>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    }

</div>

