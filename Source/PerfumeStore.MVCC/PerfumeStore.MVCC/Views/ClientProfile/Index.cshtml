@model ClientProfileViewModel

@{
    ViewData["Title"] = "Профиль";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = "Профиль",
    Subtitle = "Ваши контактные данные и настройки учётной записи",
    Icon = "bi-person"
})" />

<div class="store-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-4">ФИО</dt>
        <dd class="col-sm-8 fw-semibold">@Model.FullName</dd>
        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>
        <dt class="col-sm-4">Телефон</dt>
        <dd class="col-sm-8">@(Model.Phone ?? "—")</dd>
        <dt class="col-sm-4">Роль</dt>
        <dd class="col-sm-8"><partial name="_UserRoleBadge" model="@Model.Role" /></dd>
        <dt class="col-sm-4">Дата регистрации</dt>
        <dd class="col-sm-8">@Model.CreatedAt.ToString("g")</dd>
    </dl>
</div>

<a class="btn btn-dark" asp-action="Edit"><i class="bi bi-pencil me-1"></i>Редактировать</a>
