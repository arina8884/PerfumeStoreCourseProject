@model ProductEditViewModel

@{
    ViewData["Title"] = "Редактирование товара";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = "Редактирование товара",
    Subtitle = "Обновите данные карточки товара в каталоге",
    Icon = "bi-pencil"
})" />

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="store-panel store-form">
    @Html.AntiForgeryToken()
    <partial name="_ProductContentEditForm" model="Model" />
    @{ ViewData["CancelUrl"] = Url.Action("Index"); ViewData["SubmitText"] = "Сохранить"; }
    <partial name="_FormActions" />
</form>