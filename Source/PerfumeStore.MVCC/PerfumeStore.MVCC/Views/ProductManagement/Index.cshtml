@model ProductManagementListViewModel

@{
    ViewData["Title"] = "Управление товарами";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <partial name="_PageHeader" model="@(new PageHeaderViewModel {
        Title = "Управление товарами",
        Subtitle = "Активные позиции каталога: редактирование, предпросмотр и архивация",
        Icon = "bi-box-seam"
    })" />
    <a class="btn btn-dark align-self-start" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Добавить товар</a>
</div>

@if (Model.Products.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Товаров пока нет",
        Description = "Создайте первую позицию каталога — она сразу появится в магазине",
        Icon = "bi-box",
        ButtonText = "Добавить товар",
        ButtonController = "ProductManagement",
        ButtonAction = "Create"
    })" />
}
else
{
    <div class="table-responsive store-panel p-0 overflow-hidden">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Фото</th>
                    <th>Название</th>
                    <th>Бренд</th>
                    <th>Категория</th>
                    <th>Цена</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <img class="rounded border bg-light" src="@ImageUrlHelper.GetProductImageUrl(product.ImageUrl)" alt="@product.Name" style="width:48px;height:48px;object-fit:contain;" />
                        </td>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.Brand</td>
                        <td>@product.CategoryName</td>
                        <td>@product.Price.ToString("N2") BYN</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-dark" asp-action="Preview" asp-route-id="@product.Id"><i class="bi bi-eye"></i></a>
                                <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@product.Id"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Archive" asp-route-id="@product.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="В архив"><i class="bi bi-archive"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
