@model EmptyStateViewModel

<div class="store-empty-state text-center">
    <div class="store-empty-state-icon mb-3">
        <i class="bi @Model.Icon"></i>
    </div>
    <h2 class="h5 mb-2">@Model.Title</h2>
    <p class="text-muted mb-4">@Model.Description</p>
    @if (!string.IsNullOrWhiteSpace(Model.ButtonText) && !string.IsNullOrWhiteSpace(Model.ButtonController) && !string.IsNullOrWhiteSpace(Model.ButtonAction))
    {
        <a class="btn btn-dark" asp-controller="@Model.ButtonController" asp-action="@Model.ButtonAction">@Model.ButtonText</a>
    }
</div>
