<!DOCTYPE html>

<html lang="ru">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PerfumeStore</title>

    <meta name="description" content="@(ViewData["MetaDescription"] as string ?? "PerfumeStore — парфюмерия в Минске, доставка по Беларуси")" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/PerfumeStore.MVCC.styles.css" asp-append-version="true" />

</head>

<body class="d-flex flex-column min-vh-100">

    @{

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

        var isGuest = User.Identity?.IsAuthenticated != true;

        var isClient = User.IsInRole(UserRoles.Client);

        var isStaff = User.IsInRole(UserRoles.ContentManager)

            || User.IsInRole(UserRoles.OrderManager)

            || User.IsInRole(UserRoles.Admin);

        string NavClass(string controller, string? action = null) =>

            currentController.Equals(controller, StringComparison.OrdinalIgnoreCase)

            && (action is null || currentAction.Equals(action, StringComparison.OrdinalIgnoreCase))

                ? "nav-link active"

                : "nav-link";

    }

    <header class="store-header sticky-top">

        <nav class="navbar navbar-expand-lg py-2 py-lg-3">

            <div class="container">

                <a class="navbar-brand store-brand" asp-controller="Home" asp-action="Index" title="На главную">

                    <img src="~/images/logo.svg" alt="PerfumeStore" class="store-brand-logo" width="140" height="32" />

                </a>



                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#storeNavbar" aria-controls="storeNavbar" aria-expanded="false" aria-label="Меню">

                    <span class="navbar-toggler-icon"></span>

                </button>



                <div class="collapse navbar-collapse" id="storeNavbar">

                    @if (isGuest || isClient)

                    {

                        <ul class="navbar-nav mx-auto store-center-nav">

                            <li class="nav-item">

                                <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index">Главная</a>

                            </li>

                            <li class="nav-item">

                                <a class="@NavClass("Catalog")" asp-controller="Catalog" asp-action="Index">Каталог</a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link store-nav-anchor" asp-controller="Home" asp-action="Index" asp-fragment="about" data-nav-anchor="about">О магазине</a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link store-nav-anchor" asp-controller="Home" asp-action="Index" asp-fragment="contacts" data-nav-anchor="contacts">Контакты</a>

                            </li>

                        </ul>

                    }



                    <div class="store-header-actions ms-lg-auto d-flex align-items-center gap-2">

                        @if (isClient)

                        {

                            @await Component.InvokeAsync("ClientNavItems")

                        }

                        else if (isStaff)

                        {

                            @if (User.IsInRole(UserRoles.ContentManager))

                            {

                                <a class="btn btn-dark btn-sm @(currentController == "ContentManager" ? "active" : null)" asp-controller="ContentManager" asp-action="Index"><i class="bi bi-pencil-square me-1"></i>Панель</a>

                            }

                            @if (User.IsInRole(UserRoles.OrderManager))

                            {

                                <a class="btn btn-dark btn-sm @(currentController == "OrderManager" ? "active" : null)" asp-controller="OrderManager" asp-action="Index"><i class="bi bi-truck me-1"></i>Панель</a>

                            }

                            @if (User.IsInRole(UserRoles.Admin))

                            {

                                <a class="btn btn-dark btn-sm @(currentController == "Admin" ? "active" : null)" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock me-1"></i>Панель</a>

                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">

                                @Html.AntiForgeryToken()

                                <button class="btn btn-outline-dark btn-sm" type="submit">Выход</button>

                            </form>

                        }

                        else

                        {

                            <a class="btn btn-sm store-auth-btn store-auth-btn-outline @(currentController == "Account" && currentAction == "Login" ? "is-active" : null)" asp-controller="Account" asp-action="Login">Вход</a>

                            <a class="btn btn-sm store-auth-btn store-auth-btn-solid @(currentController == "Account" && currentAction == "Register" ? "is-active" : null)" asp-controller="Account" asp-action="Register">Регистрация</a>

                        }

                    </div>

                </div>

            </div>

        </nav>

    </header>



    <main role="main" class="flex-grow-1 pb-4">

        <div class="container pt-3">

            <partial name="_FlashMessages" />

            @RenderBody()

        </div>

    </main>



    @await Component.InvokeAsync("SiteFooter")



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

