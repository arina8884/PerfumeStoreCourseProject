@model ProductCatalogViewModel

@{
    ViewData["Title"] = "Каталог";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Каталог</h1>
        <p class="text-muted mb-0">Все активные товары из базы данных.</p>
    </div>
</div>

<div class="row g-4">
    <aside class="col-lg-3">
        <div class="border rounded-3 p-3">
            <h2 class="h5">Фильтр</h2>
            <form asp-controller="Catalog" asp-action="Index" method="get">
                <div class="mb-3">
                    <label class="form-label" for="SearchQuery">Поиск</label>
                    <input class="form-control" id="SearchQuery" name="SearchQuery" value="@Model.Filter.SearchQuery" placeholder="Название или бренд" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="CategoryId">Категория</label>
                    <select class="form-select" id="CategoryId" name="CategoryId">
                        <option value="">Все категории</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" selected="@(Model.Filter.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="SortBy">Сортировка</label>
                    <select class="form-select" id="SortBy" name="SortBy">
                        <option value="">По названию</option>
                        <option value="price_asc" selected="@(Model.Filter.SortBy == "price_asc")">Цена по возрастанию</option>
                        <option value="price_desc" selected="@(Model.Filter.SortBy == "price_desc")">Цена по убыванию</option>
                        <option value="name" selected="@(Model.Filter.SortBy == "name")">По названию</option>
                        <option value="newest" selected="@(Model.Filter.SortBy == "newest")">По новизне</option>
                    </select>
                </div>

                <button class="btn btn-dark w-100" type="submit">Применить</button>
            </form>

            <hr />

            <h3 class="h6">Категории</h3>
            <div class="list-group">
                <a class="list-group-item list-group-item-action" asp-controller="Catalog" asp-action="Index">Все товары</a>
                @foreach (var category in Model.Categories)
                {
                    <a class="list-group-item list-group-item-action" href="/catalog/category/@category.Id">
                        @category.Name
                    </a>
                }
            </div>
        </div>
    </aside>

    <section class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">Найдено товаров: @Model.Products.Count</span>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="alert alert-light border">Товары не найдены.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100">
                            <img class="card-img-top bg-light" src="@(product.ImageUrl ?? "/images/products/no-image.png")" alt="@product.Name" />
                            <div class="card-body d-flex flex-column">
                                <div class="text-muted small">@product.CategoryName</div>
                                <div class="text-muted small">@product.Brand</div>
                                <h2 class="h5">@product.Name</h2>
                                <p class="mb-1">Объем: @product.Volume мл</p>
                                <p class="mb-1">Остаток: @product.StockQuantity</p>
                                <p class="fw-bold">@product.Price.ToString("N2")</p>
                                <div class="mt-auto d-grid gap-2">
                                    <a class="btn btn-outline-dark" href="/product/@product.Id">Подробнее</a>
                                    @if (User.IsInRole(UserRoles.Client))
                                    {
                                        <form asp-controller="Cart" asp-action="Add" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                            <button class="btn btn-dark w-100" type="submit" disabled="@(product.StockQuantity <= 0)">
                                                В корзину
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>
