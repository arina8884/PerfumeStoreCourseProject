@{
    ViewData["Title"] = "Страница не найдена";
    ViewData["MetaDescription"] = "Запрашиваемая страница не найдена. Вернитесь в каталог PerfumeStore или на главную.";
    Layout = "_Layout";
}

<div class="text-center py-5">
    <div class="access-denied-icon mb-4">
        <i class="bi bi-search"></i>
    </div>
    <div class="display-4 fw-bold text-muted mb-2">404</div>
    <h1 class="h3 mb-3">Страница не найдена</h1>
    <p class="text-muted mx-auto mb-4 page-error-text">
        Запрашиваемая страница не существует или была перемещена. Проверьте адрес или вернитесь на главную.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <button class="btn btn-outline-dark" type="button" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i>Вернуться назад</button>
        <a class="btn btn-dark" asp-controller="Catalog" asp-action="Index"><i class="bi bi-grid me-1"></i>В каталог</a>
        <a class="btn btn-outline-dark" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>На главную</a>
    </div>
</div>
