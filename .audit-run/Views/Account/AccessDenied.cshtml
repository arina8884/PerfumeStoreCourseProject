@{
    ViewData["Title"] = "Доступ запрещён";
    ViewData["MetaDescription"] = "Доступ к странице PerfumeStore запрещён. Вернитесь на главную или войдите под другой учётной записью.";
}

<div class="text-center py-5">
    <div class="access-denied-icon mb-4">
        <i class="bi bi-shield-lock"></i>
    </div>
    <div class="display-4 fw-bold text-muted mb-2">403</div>
    <h1 class="h3 mb-3">Доступ запрещён</h1>
    <p class="text-muted mx-auto mb-4" style="max-width: 520px;">
        У вас нет прав для просмотра этой страницы. Если вы считаете, что это ошибка, войдите под другой учётной записью или вернитесь на главную.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <button class="btn btn-outline-dark" type="button" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i>Вернуться назад</button>
        <a class="btn btn-dark" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>На главную</a>
    </div>
</div>
