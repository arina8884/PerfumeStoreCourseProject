@model ContentManagerDashboardViewModel



@{
    ViewData["Title"] = "Панель контент-менеджера";
    ViewData["MetaDescription"] = "Панель контент-менеджера PerfumeStore — управление каталогом, категориями и товарами.";
}



<partial name="_PageHeader" model="@(new PageHeaderViewModel {

    Title = "Панель контент-менеджера",

    Subtitle = "Управление каталогом, карточками товаров, категориями и изображениями.",

    Icon = "bi-pencil-square"

})" />



<div class="row g-3 mb-4">

    <div class="col-6 col-md-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Всего товаров", Value = Model.ProductsCount.ToString(), Icon = "bi-box-seam" })" /></div>

    <div class="col-6 col-md-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Активные", Value = Model.ActiveProductsCount.ToString(), Icon = "bi-check2" })" /></div>

    <div class="col-6 col-md-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Категории", Value = Model.CategoriesCount.ToString(), Icon = "bi-tags" })" /></div>

    <div class="col-6 col-md-3"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "В архиве", Value = Model.ArchivedProductsCount.ToString(), Icon = "bi-archive" })" /></div>

</div>



<div class="store-panel mb-4">

    <div class="store-panel-title"><i class="bi bi-lightning me-2"></i>Быстрые действия</div>

    <div class="d-flex flex-wrap gap-2 store-quick-actions">

        <a class="btn btn-dark" asp-controller="ProductManagement" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Добавить товар</a>

        <a class="btn btn-outline-dark" asp-controller="CategoryManagement" asp-action="Create"><i class="bi bi-folder-plus me-1"></i>Добавить категорию</a>

        <a class="btn btn-outline-dark" asp-controller="ProductManagement" asp-action="Index"><i class="bi bi-grid me-1"></i>Все товары</a>

        <a class="btn btn-outline-dark" asp-controller="ProductManagement" asp-action="Archived"><i class="bi bi-archive me-1"></i>Архив</a>

    </div>

</div>



<div class="store-panel mb-4">

    <div class="store-panel-title"><i class="bi bi-clock-history me-2"></i>Недавно добавленные товары</div>

    @if (Model.RecentProducts.Count == 0)

    {

        <partial name="_EmptyState" model="@(new EmptyStateViewModel {

            Title = "Товаров пока нет",

            Description = "Создайте первую карточку товара для каталога.",

            Icon = "bi-box",

            ButtonText = "Добавить товар",

            ButtonController = "ProductManagement",

            ButtonAction = "Create"

        })" />

    }

    else

    {

        <div class="table-responsive">

            <table class="table store-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>Товар</th>

                        <th>Бренд</th>

                        <th>Цена</th>

                        <th class="text-end">Действия</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var product in Model.RecentProducts)

                    {

                        <tr>

                            <td>

                                <div class="d-flex align-items-center gap-2">

                                    <img src="@ImageUrlHelper.GetProductImageUrl(product.ImageUrl)" alt="@product.Name" class="table-thumb-image" />

                                    <span class="fw-semibold">@product.Name</span>

                                </div>

                            </td>

                            <td>@product.Brand</td>

                            <td>@product.Price.ToString("N2") BYN</td>

                            <td class="text-end">

                                <a class="btn btn-sm btn-outline-dark" asp-controller="ProductManagement" asp-action="Edit" asp-route-id="@product.Id">Изменить</a>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    }

</div>



<div class="store-panel">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

        <div class="store-panel-title mb-0"><i class="bi bi-tags me-2"></i>Категории каталога</div>

        <a class="btn btn-sm btn-outline-dark" asp-controller="CategoryManagement" asp-action="Index">Все категории</a>

    </div>

    @if (Model.RecentCategories.Count == 0)

    {

        <partial name="_EmptyState" model="@(new EmptyStateViewModel {

            Title = "Категорий пока нет",

            Description = "Создайте первую категорию для группировки товаров.",

            Icon = "bi-tags",

            ButtonText = "Добавить категорию",

            ButtonController = "CategoryManagement",

            ButtonAction = "Create"

        })" />

    }

    else

    {

        <div class="table-responsive">

            <table class="table store-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>Название</th>

                        <th>Описание</th>

                        <th class="text-end">Действия</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var category in Model.RecentCategories)

                    {

                        <tr>

                            <td class="fw-semibold">@category.Name</td>

                            <td class="text-muted">@(category.Description ?? "—")</td>

                            <td class="text-end">

                                <a class="btn btn-sm btn-outline-dark" asp-controller="CategoryManagement" asp-action="Edit" asp-route-id="@category.Id">Изменить</a>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    }

</div>

