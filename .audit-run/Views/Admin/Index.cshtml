@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Админ-панель";
    ViewData["MetaDescription"] = "Админ-панель PerfumeStore — статистика системы, пользователи и отчёты.";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = "Админ-панель",
    Subtitle = "Общая статистика системы, пользователи и отчёты.",
    Icon = "bi-shield-lock"
})" />

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Пользователи", Value = Model.UsersCount.ToString(), Icon = "bi-people" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Клиенты", Value = Model.ClientsCount.ToString(), Icon = "bi-person" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Менеджеры", Value = Model.ManagersCount.ToString(), Icon = "bi-person-badge" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Заказы", Value = Model.OrdersCount.ToString(), Icon = "bi-bag" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Товары", Value = Model.ProductsCount.ToString(), Icon = "bi-droplet" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Активные", Value = Model.ActiveProductsCount.ToString(), Icon = "bi-check-circle" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Архив", Value = Model.ArchivedProductsCount.ToString(), Icon = "bi-archive" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Категории", Value = Model.CategoriesCount.ToString(), Icon = "bi-tags" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Поставщики", Value = Model.SuppliersCount.ToString(), Icon = "bi-truck" })" /></div>
    <div class="col-6 col-md-4 col-xl-2"><partial name="_StatCard" model="@(new StatCardViewModel { Label = "Заявки", Value = Model.SupplyRequestsCount.ToString(), Icon = "bi-clipboard-check" })" /></div>
</div>

<div class="store-panel mb-4">
    <div class="store-panel-title"><i class="bi bi-lightning me-2"></i>Быстрые действия</div>
    <div class="d-flex flex-wrap gap-2 store-quick-actions">
        <a class="btn btn-dark" asp-controller="UserManagement" asp-action="Index"><i class="bi bi-people me-1"></i>Пользователи</a>
        <a class="btn btn-outline-dark" asp-controller="UserManagement" asp-action="Create"><i class="bi bi-person-plus me-1"></i>Создать пользователя</a>
        <a class="btn btn-outline-dark" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph me-1"></i>Отчёты</a>
    </div>
</div>

<div class="row g-4 mb-4">


    <div class="col-lg-6">

        <div class="store-panel h-100">

            <div class="store-panel-title"><i class="bi bi-person-plus me-2"></i>Последние пользователи</div>

            @if (Model.RecentUsers.Count == 0)

            {

                <partial name="_EmptyState" model="@(new EmptyStateViewModel {

                    Title = "Пользователей пока нет",

                    Description = "Создайте первую учётную запись сотрудника или клиента.",

                    Icon = "bi-people",

                    ButtonText = "Создать пользователя",

                    ButtonController = "UserManagement",

                    ButtonAction = "Create"

                })" />

            }

            else

            {

                <ul class="list-group list-group-flush">

                    @foreach (var user in Model.RecentUsers)

                    {

                        <li class="list-group-item px-0 d-flex justify-content-between align-items-start gap-2">

                            <div>

                                <div class="fw-semibold">@user.FullName</div>

                                <div class="small text-muted">@user.Email</div>

                            </div>

                            <partial name="_UserRoleBadge" model="@user.Role" />

                        </li>

                    }

                </ul>

                <a class="btn btn-outline-dark btn-sm mt-3" asp-controller="UserManagement" asp-action="Index">Все пользователи</a>

            }

        </div>

    </div>

    <div class="col-lg-6">

        <div class="store-panel h-100">

            <div class="store-panel-title"><i class="bi bi-bag me-2"></i>Последние заказы</div>

            @if (Model.RecentOrders.Count == 0)

            {

                <partial name="_EmptyState" model="@(new EmptyStateViewModel {

                    Title = "Заказов пока нет",

                    Description = "Заказы клиентов появятся здесь после оформления покупок.",

                    Icon = "bi-bag"

                })" />

            }

            else

            {

                <ul class="list-group list-group-flush">

                    @foreach (var order in Model.RecentOrders)

                    {

                        <li class="list-group-item px-0">

                            <div class="d-flex justify-content-between mb-1">

                                <span class="fw-semibold">#@order.OrderId</span>

                                <partial name="_OrderStatusBadge" model="@order.Status" />

                            </div>

                            <div class="small text-muted">@order.ClientFullName · @order.OrderDate.ToString("g")</div>

                        </li>

                    }

                </ul>

            }

        </div>

    </div>

</div>



<div class="store-panel">

    <div class="store-panel-title"><i class="bi bi-file-earmark-bar-graph me-2"></i>Экспорт отчётов</div>

    <p class="text-muted small mb-3">Сводные отчёты по пользователям, заказам, товарам, поставщикам и заявкам с экспортом в Excel, PDF и Word.</p>

    <div class="d-flex flex-wrap gap-2">

        <a class="btn btn-dark" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart me-1"></i>Открыть отчёты</a>

        <a class="btn btn-outline-dark" asp-controller="UserManagement" asp-action="Index"><i class="bi bi-people me-1"></i>Управление пользователями</a>

    </div>

</div>

