@model IReadOnlyList<CategoryViewModel>

@{
    ViewData["Title"] = "Категории";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <partial name="_PageHeader" model="@(new PageHeaderViewModel {
        Title = "Категории",
        Subtitle = "Структура каталога: группировка ароматов по направлениям.",
        Icon = "bi-grid"
    })" />
    <a class="btn btn-dark align-self-start" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Добавить категорию</a>
</div>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Категорий пока нет",
        Description = "Создайте категории, чтобы удобно группировать товары в каталоге.",
        Icon = "bi-grid",
        ButtonText = "Добавить категорию",
        ButtonController = "CategoryManagement",
        ButtonAction = "Create"
    })" />
}
else
{
    <div class="table-responsive store-panel p-0 overflow-hidden">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Описание</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold">@category.Name</td>
                        <td class="text-muted">@(category.Description ?? "—")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@category.Id"><i class="bi bi-pencil me-1"></i>Изменить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
