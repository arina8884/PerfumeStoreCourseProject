@model ArchivedProductsViewModel

@{
    ViewData["Title"] = "Архив товаров";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = "Архив товаров",
    Subtitle = "Снятые с продажи позиции — можно восстановить в каталог.",
    Icon = "bi-archive"
})" />

@if (Model.Products.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "В архиве пока нет товаров",
        Description = "Архивированные позиции появятся здесь после снятия с продажи.",
        Icon = "bi-archive",
        ButtonText = "К активным товарам",
        ButtonController = "ProductManagement",
        ButtonAction = "Index"
    })" />
}
else
{
    <div class="table-responsive store-panel p-0 overflow-hidden mb-4">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Фото</th>
                    <th>Название</th>
                    <th>Бренд</th>
                    <th>Категория</th>
                    <th>Цена</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>
                            <img class="rounded border bg-light" src="@ImageUrlHelper.GetProductImageUrl(product.ImageUrl)" alt="@product.Name" style="width:48px;height:48px;object-fit:contain;" />
                        </td>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@product.Brand</td>
                        <td>@product.CategoryName</td>
                        <td>@product.Price.ToString("N2") BYN</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-dark" asp-action="Preview" asp-route-id="@product.Id"><i class="bi bi-eye me-1"></i>Просмотр</a>
                                <form asp-action="Activate" asp-route-id="@product.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-dark" type="submit"><i class="bi bi-arrow-counterclockwise me-1"></i>Восстановить</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a class="btn btn-outline-dark" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>К активным товарам</a>
