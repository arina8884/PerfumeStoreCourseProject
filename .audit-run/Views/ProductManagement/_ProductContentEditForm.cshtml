@model ProductEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label">Категория</label>
    <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, nameof(CategoryViewModel.Id), nameof(CategoryViewModel.Name)))">
        <option value="">Выберите категорию</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Name" class="form-label">Название <span class="text-danger">*</span></label>
    <input asp-for="Name" class="form-control" placeholder="Например, Chanel No.5" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Brand" class="form-label">Бренд <span class="text-danger">*</span></label>
    <input asp-for="Brand" class="form-control" placeholder="Например, Chanel" />
    <span asp-validation-for="Brand" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Price" class="form-label">Цена</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Volume" class="form-label">Объём, мл</label>
        <input asp-for="Volume" class="form-control" />
        <span asp-validation-for="Volume" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label">Описание</label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Краткое описание аромата, ноты и особенности"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-4">
    <label asp-for="ImageFile" class="form-label">Изображение</label>
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <div class="mb-2">
            <partial name="_ProductImage" view-data='new ViewDataDictionary(ViewData) { { "ImageUrl", Model.ImageUrl }, { "ImageAlt", "Текущее изображение" }, { "ImageClass", "img-thumbnail" } }' />
        </div>
    }
    <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
    <div class="form-text">JPG, PNG или WEBP, до 5 МБ.</div>
</div>
