@model UserListViewModel

@{
    ViewData["Title"] = "Пользователи";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <partial name="_PageHeader" model="@(new PageHeaderViewModel {
        Title = "Пользователи",
        Subtitle = "Учётные записи клиентов и сотрудников магазина.",
        Icon = "bi-people"
    })" />
    <a class="btn btn-dark align-self-start" asp-action="Create"><i class="bi bi-person-plus me-1"></i>Добавить пользователя</a>
</div>

@if (Model.Users.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Пользователей пока нет",
        Description = "Создайте учётную запись для клиента или сотрудника.",
        Icon = "bi-person",
        ButtonText = "Добавить пользователя",
        ButtonController = "UserManagement",
        ButtonAction = "Create"
    })" />
}
else
{
    <div class="table-responsive store-panel p-0 overflow-hidden">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>ФИО</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Дата регистрации</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td><partial name="_UserRoleBadge" model="@user.Role" /></td>
                        <td>@user.CreatedAt.ToString("g")</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@user.Id"><i class="bi bi-eye me-1"></i>Просмотр</a>
                                <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@user.Id"><i class="bi bi-pencil me-1"></i>Изменить</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
