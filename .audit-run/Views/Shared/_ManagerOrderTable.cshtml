@model IEnumerable<ManagerOrderSummaryViewModel>

@if (!Model.Any())
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Title = "Заказов пока нет",
        Description = "Новые заказы появятся здесь автоматически.",
        Icon = "bi-inbox"
    })" />
}
else
{
    <div class="table-responsive">
        <table class="table store-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Дата</th>
                    <th>Клиент</th>
                    <th>Сумма</th>
                    <th>Статус</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><span class="fw-semibold">#@order.OrderId</span></td>
                        <td>@order.OrderDate.ToString("g")</td>
                        <td>@order.ClientFullName</td>
                        <td>@order.TotalAmount.ToString("N2") BYN</td>
                        <td><partial name="_OrderStatusBadge" model="@order.Status" /></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-controller="OrderManagement" asp-action="Details" asp-route-id="@order.OrderId">
                                <i class="bi bi-eye me-1"></i>Подробнее
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
