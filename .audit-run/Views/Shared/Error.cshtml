@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
    ViewData["MetaDescription"] = "На сайте PerfumeStore произошла ошибка. Вернитесь на главную или повторите попытку позже.";
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel {
    Title = "Произошла ошибка",
    Subtitle = "При обработке запроса возникла непредвиденная ситуация.",
    Icon = "bi-exclamation-triangle"
})" />

<div class="store-panel text-center">
    <div class="access-denied-icon mb-3 text-danger">
        <i class="bi bi-exclamation-octagon"></i>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted mb-3">Идентификатор запроса: <code>@Model.RequestId</code></p>
    }
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <button class="btn btn-outline-dark" type="button" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i>Вернуться назад</button>
        <a class="btn btn-dark" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>На главную</a>
    </div>
</div>
